{
    "name": "DuckConf",
    "website": "https://example.com/duckconf",
    "branding": {
        "url": "logo.png",
        "size": 300,
        "padding": 40,
        "anchor": "top-right"
    },
    "default_hashtags": [
        "#DuckConf"
    ],
    "handles": {
        "@duckconf": {
            "twitter": "@duckconf",
            "mastodon": "@duckconf@mastodon.social"
        }
    },
    "frames": [
        {
            "id": "duckconf_banner_logo",
            "name": "DuckConf Banner",
            "type": "dynamic_banner",
            "defaultText": "#DuckConf\nhttps://example.com/duckconf",
            "bgColor": "#1c1917",
            "borderColor": "#ffffff",
            "textColor": "#ffffff",
            "opacity": 0.9,
            "height": 130,
            "margin": 30,
            "borderRadius": 30,
            "fontSize": 30,
            "assets": [
                {
                    "url": "logo.png",
                    "anchor": "right",
                    "size": 250,
                    "padding": 20
                }
            ]
        },
        {
            "id": "blue_duck_card",
            "name": "Blue Duck",
            "type": "dynamic_banner",
            "defaultText": "#DuckConf",
            "bgColor": "#ffffff",
            "borderColor": "#fbbf24",
            "textColor": "#1c1917",
            "opacity": 0.5,
            "height": 130,
            "margin": 30,
            "borderRadius": 30,
            "fontSize": 30,
            "assets": [
                {
                    "url": "frames/DuckBlue.png",
                    "anchor": "left",
                    "flipX": true,
                    "size": 240,
                    "offsetY": -30,
                    "padding": -30
                }
            ]
        },
        {
            "id": "yellow_duck_card",
            "name": "Yellow Duck",
            "type": "dynamic_banner",
            "defaultText": "#DuckConf",
            "bgColor": "#ffffff",
            "borderColor": "#fbbf24",
            "textColor": "#1c1917",
            "opacity": 0.5,
            "height": 130,
            "margin": 30,
            "borderRadius": 30,
            "fontSize": 30,
            "assets": [
                {
                    "url": "frames/DuckYellow.png",
                    "anchor": "left",
                    "flipX": true,
                    "size": 240,
                    "offsetY": -30,
                    "padding": -30
                }
            ]
        }
    ]
}
